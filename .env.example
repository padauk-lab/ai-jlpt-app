# Copy this file to .env and fill in real values. Never commit .env

# Database
POSTGRES_USER=jlpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jlpt
DATABASE_URL=postgresql://jlpt:change-me@db:5432/jlpt

# Google login
GOOGLE_CLIENT_ID=your-google-client-id

# AI
LLM_API_KEY=your-llm-api-key

# Login tokens: a long random secret, at least 32 characters. Never share it.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Web pages allowed to call the API from a browser, comma separated (no "*", no "/" at the end).
# http://localhost:8081 is the Expo web app on your own computer. The phone apps don't need this.
CORS_ORIGINS=http://localhost:8081
