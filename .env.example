# Copy this file to .env and fill in real values. Never commit .env

# Push notifications (daily study reminder). "off": nothing is sent. "log": reminders are written to
# the backend log only, for testing. "expo": real notifications, for the online server.
PUSH_MODE=off
# Only if "enhanced push security" is on in the Expo account. A secret, like a password.
# EXPO_ACCESS_TOKEN=your-expo-access-token

# Database
POSTGRES_USER=jlpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jlpt
DATABASE_URL=postgresql://jlpt:change-me@db:5432/jlpt

# Who can reach the backend. Leave it out (or 127.0.0.1): only this computer. Safest, use this normally.
# To test the app on your phone over your HOME Wi-Fi, set BACKEND_HOST=0.0.0.0 and use your computer's
# Wi-Fi address in the app (EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1).
# Never use 0.0.0.0 on public Wi-Fi (school, cafe, station): everyone on that network could reach it.
# BACKEND_HOST=0.0.0.0

# Google login
GOOGLE_CLIENT_ID=your-google-client-id

# AI
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-3.8-flash

# Login tokens: a long random secret, at least 32 characters. Never share it.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Web pages allowed to call the API from a browser, comma separated (no "*", no "/" at the end).
# http://localhost:8081 is the Expo web app on your own computer. The phone apps don't need this.
CORS_ORIGINS=http://localhost:8081
