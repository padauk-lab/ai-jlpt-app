# Copy this to .env.local (Git ignores .env.local) and change it if needed.
# Only addresses here, never secrets: anything starting with EXPO_PUBLIC_ is visible inside the app.

# Backend address. localhost works in the browser on your Mac.
# For your iPhone, use your Mac's address instead, e.g. http://192.168.1.23:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
